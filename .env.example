# === Configuration d'environnement — Gestion des ventes de blocs de glace ===
# Copiez ce fichier en .env puis adaptez les valeurs.
# cp .env.example .env

# --- Sécurité ---
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changez-moi-par-une-vraie-cle-secrete
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de données ---
# PostgreSQL (recommandé / imposé) :
# DATABASE_URL=postgres://gestion_user:motdepasse@localhost:5432/gestion_glace
#
# Si DATABASE_URL est absente ou commentée, l'application retombe automatiquement
# sur SQLite (fichier db.sqlite3) pour un démarrage immédiat en développement.
# DATABASE_URL=postgres://gestion_user:motdepasse@localhost:5432/gestion_glace

# --- Journalisation ---
LOG_LEVEL=INFO

# --- Production uniquement (DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
